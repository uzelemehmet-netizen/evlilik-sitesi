{
  "name": "web-sitem-new",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "fetch:youtube-thumbs": "node scripts/fetch-youtube-thumbs.mjs",
    "prebuild": "node scripts/fetch-youtube-thumbs.mjs",
    "ensure:env": "node scripts/ensure-env-local.mjs",
    "admin:check": "node scripts/admin-user.mjs --email uzelemehmet@gmail.com --check",
    "admin:setpw": "node scripts/admin-user.mjs --email uzelemehmet@gmail.com",
    "admin:grant": "node scripts/admin-user.mjs --email uzelemehmet@gmail.com --set-admin-claim",
    "admin:revoke": "node scripts/admin-user.mjs --email uzelemehmet@gmail.com --clear-admin-claim",
    "admin:signups:today": "node scripts/admin-count-signups-today.mjs --tzOffsetMin 180",
    "admin:clickstats": "node scripts/admin-click-stats-dump.mjs --days 7 --focus signup --topEvents 20 --topSignupErrors 15 --includeAuthSignups true",
    "admin:clickstats:snapshot": "node scripts/admin-clickstats-snapshot.mjs --days 7 --focus signup --topEvents 20 --topSignupErrors 15 --includeAuthSignups true",
    "admin:clickstats:compare": "node scripts/admin-clickstats-compare.mjs --latest2",
    "admin:feedback:dump": "node scripts/admin-feedback-dump.mjs --limit 30",
    "firestore:inspect:signups": "node scripts/firestore-inspect-signups.mjs --limit 10",
    "seed:matchmaking": "node scripts/seed-matchmaking.mjs",
    "seed:matchmaking:cleanup": "node scripts/seed-matchmaking.mjs --cleanup",
    "seed:promote-matches": "node scripts/promote-seed-matches.mjs",
    "matchmaking:cron": "node scripts/run-matchmaking-cron.mjs",
    "matchmaking:debug-user": "node scripts/matchmaking-debug-user.mjs",
    "matchmaking:backfill:profile-text-translations": "node scripts/backfill-matchmaking-profile-text-translations.mjs",
    "matchmaking:backfill:occupation-translations": "node scripts/backfill-matchmaking-occupation-translations.mjs",
    "dev:web": "npm run ensure:env && vite",
    "dev:web:direct": "vite",
    "dev:api": "node --watch scripts/dev-api.mjs",
    "dev": "node scripts/dev.mjs",
    "playwright:install": "playwright install chromium",
    "playwright:install:deps": "playwright install --with-deps chromium",
    "playwright:install-deps": "playwright install-deps chromium",
    "test:e2e": "playwright test",
    "test:e2e:reviews": "playwright test tests/app-review-prompt.e2e.spec.js tests/public-review-moderation.e2e.spec.js",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "node --test unit-tests/*.test.mjs",
    "generate:brochure-pdfs": "node scripts/generate-brochure-pdfs.mjs",
    "generate:brochure-pdfs:strict": "node scripts/generate-brochure-pdfs.mjs --strict",
    "build": "vite build",
    "build:full": "node scripts/generate-brochure-pdfs.mjs && node scripts/fetch-youtube-thumbs.mjs && vite build",
    "preview": "vite preview",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "i18n:usage": "node scripts/i18n-usage-audit.mjs",
    "lint": "node -e \"console.log('lint bilinçli olarak kapalı (performans için). İstersen: npm run lint:full')\"",
    "lint:full": "eslint --cache --cache-location .eslintcache \"src/**/*.{js,jsx}\""
  },
  "dependencies": {
    "@cloudinary/react": "^1.14.3",
    "@cloudinary/url-gen": "^1.22.0",
    "@emailjs/browser": "^4.4.1",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/orbitron": "^5.2.8",
    "@fontsource/oregano": "^5.2.7",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@fontsource/poppins": "^5.2.7",
    "@fontsource/rajdhani": "^5.2.7",
    "firebase": "^12.8.0",
    "firebase-admin": "^13.0.2",
    "i18next": "^25.7.3",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.5.0",
    "react-router-dom": "^6.20.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.7",
    "globals": "^15.14.0",
    "playwright": "^1.51.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.32",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "vercel": "^34.3.0",
    "vite": "^5.0.8",
    "vite-plugin-pwa": "^1.2.0",
    "wait-on": "^7.2.0"
  }
}
